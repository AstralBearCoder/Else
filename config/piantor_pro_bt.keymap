#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        Virg_Inter: Virg_Inter {
            compatible = "zmk,behavior-mod-morph";
            label = "VIRG_INTER";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;
            mods = <(MOD_LSFT)>;
        };

        Point_Excl: Point_Excl {
            compatible = "zmk,behavior-mod-morph";
            label = "POINT_EXCL";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp EXCL>;
            mods = <(MOD_LSFT)>;
        };

        Colon_Scl: Colon_Scl {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SCL";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMICOLON>;
            mods = <(MOD_LSFT)>;
        };

        ApoGui: ApoGui {
            compatible = "zmk,behavior-mod-morph";
            label = "APOGUI";
            #binding-cells = <0>;
            bindings = <&ApoSpc>, <&GuiSpc>;
            mods = <(MOD_LSFT)>;
        };

        eETrem: eETrem {
            compatible = "zmk,behavior-mod-morph";
            label = "EETREM";
            #binding-cells = <0>;
            bindings = <&eTrem>, <&cETrem>;
            mods = <(MOD_LSFT)>;
        };

        iITrem: iITrem {
            compatible = "zmk,behavior-mod-morph";
            label = "IITREM";
            #binding-cells = <0>;
            bindings = <&iTrem>, <&cITrem>;
            mods = <(MOD_LSFT)>;
        };

        iICir: iICir {
            compatible = "zmk,behavior-mod-morph";
            label = "IICIR";
            #binding-cells = <0>;
            bindings = <&iCir>, <&cICir>;
            mods = <(MOD_LSFT)>;
        };

        aACir: aACir {
            compatible = "zmk,behavior-mod-morph";
            label = "AACIR";
            #binding-cells = <0>;
            bindings = <&aCir>, <&cACir>;
            mods = <(MOD_LSFT)>;
        };

        oOCir: oOCir {
            compatible = "zmk,behavior-mod-morph";
            label = "OOCIR";
            #binding-cells = <0>;
            bindings = <&oCir>, <&cOCir>;
            mods = <(MOD_LSFT)>;
        };

        eECir: eECir {
            compatible = "zmk,behavior-mod-morph";
            label = "EECIR";
            #binding-cells = <0>;
            bindings = <&eCir>, <&cECir>;
            mods = <(MOD_LSFT)>;
        };

        uUcir: uUcir {
            compatible = "zmk,behavior-mod-morph";
            label = "UUCIR";
            #binding-cells = <0>;
            bindings = <&uCir>, <&cUcir>;
            mods = <(MOD_LSFT)>;
        };

        aAGrv: aAGrv {
            compatible = "zmk,behavior-mod-morph";
            label = "AAGRV";
            #binding-cells = <0>;
            bindings = <&aGrv>, <&cAGrv>;
            mods = <(MOD_LSFT)>;
        };

        eEGrv: eEGrv {
            compatible = "zmk,behavior-mod-morph";
            label = "EEGRV";
            #binding-cells = <0>;
            bindings = <&eGrv>, <&cEGrv>;
            mods = <(MOD_LSFT)>;
        };

        uUGrv: uUGrv {
            compatible = "zmk,behavior-mod-morph";
            label = "UUGRV";
            #binding-cells = <0>;
            bindings = <&uGrv>, <&cUGrv>;
            mods = <(MOD_LSFT)>;
        };

        oeOE: oeOE {
            compatible = "zmk,behavior-mod-morph";
            label = "OEOE";
            #binding-cells = <0>;
            bindings = <&oe>, <&cOE>;
            mods = <(MOD_LSFT)>;
        };

        Altgralt: Altgralt {
            compatible = "zmk,behavior-tap-dance";
            label = "ALTGRALT";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&kp LEFT_ALT>;
        };

        Ctrl_to_Nav: Ctrl_to_Nav {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_TO_NAV";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&mo 3>;
        };

        Nav_to_FLaunch: Nav_to_FLaunch {
            compatible = "zmk,behavior-tap-dance";
            label = "NAV_TO_FLAUNCH";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&kp LA(SPACE)>;
        };
    };

    macros {
        qu: qu {
            compatible = "zmk,behavior-macro";
            label = "QU";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp Q &kp U>;
        };

        Mqu: Mqu {
            compatible = "zmk,behavior-macro";
            label = "MQU";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp LS(Q) &kp U>;
        };

        /* Literal ' : dead acute + SPACE. No held modifier. Requires host US-International. */
        ApoSpc: Apo_Gui {
            compatible = "zmk,behavior-macro";
            label = "APO_GUI";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp APOSTROPHE &kp SPACE>;
        };

        /* Literal " : dead diaeresis + SPACE. */
        GuiSpc: GuiSpc {
            compatible = "zmk,behavior-macro";
            label = "GUISPC";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp LS(APOSTROPHE) &kp SPACE>;
        };

        /* Macros ' + Voyelle pour éviter la transformation en accent aigu */
        apo_a: apo_a {
            compatible = "zmk,behavior-macro";
            label = "APO_A";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp APOSTROPHE &kp SPACE &kp A>;
        };

        apo_e: apo_e {
            compatible = "zmk,behavior-macro";
            label = "APO_E";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp APOSTROPHE &kp SPACE &kp E>;
        };

        apo_i: apo_i {
            compatible = "zmk,behavior-macro";
            label = "APO_I";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp APOSTROPHE &kp SPACE &kp I>;
        };

        apo_o: apo_o {
            compatible = "zmk,behavior-macro";
            label = "APO_O";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp APOSTROPHE &kp SPACE &kp O>;
        };

        apo_u: apo_u {
            compatible = "zmk,behavior-macro";
            label = "APO_U";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp APOSTROPHE &kp SPACE &kp U>;
        };

        /* Alt-code macros (host NumLock must be ON). Alt is held for ~10-20 ms. */
        oe: oe {
            compatible = "zmk,behavior-macro";
            label = "OE";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_5 &kp KP_NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        cOE: cOE {
            compatible = "zmk,behavior-macro";
            label = "cOE";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_0>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        Environ: Environ {
            compatible = "zmk,behavior-macro";
            label = "ENVIRON";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_7>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        Fois: Fois {
            compatible = "zmk,behavior-macro";
            label = "FOIS";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_2 &kp KP_NUMBER_1 &kp KP_NUMBER_5>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        Tir_Point: Tir_Point {
            compatible = "zmk,behavior-macro";
            label = "TIR_POINT";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_9>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        FlecheDr: FlecheDr {
            compatible = "zmk,behavior-macro";
            label = "FLECHEDR";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_2 &kp KP_NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        /* Dead-key accents, lowercase */
        eTrem: eTrem {
            compatible = "zmk,behavior-macro";
            label = "ETREM";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp LS(APOSTROPHE) &kp E>;
        };

        iTrem: iTrem {
            compatible = "zmk,behavior-macro";
            label = "ITREM";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp LS(APOSTROPHE) &kp I>;
        };

        iCir: iCir {
            compatible = "zmk,behavior-macro";
            label = "ICIR";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp I>;
        };

        aCir: aCir {
            compatible = "zmk,behavior-macro";
            label = "ACIR";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp A>;
        };

        oCir: oCir {
            compatible = "zmk,behavior-macro";
            label = "OCIR";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp O>;
        };

        eCir: eCir {
            compatible = "zmk,behavior-macro";
            label = "ECIR";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp E>;
        };

        uCir: uCir {
            compatible = "zmk,behavior-macro";
            label = "UCIR";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp U>;
        };

        aGrv: aGrv {
            compatible = "zmk,behavior-macro";
            label = "AGRV";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp GRAVE &kp A>;
        };

        eGrv: eGrv {
            compatible = "zmk,behavior-macro";
            label = "EGRV";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp GRAVE &kp E>;
        };

        uGrv: uGrv {
            compatible = "zmk,behavior-macro";
            label = "UGRV";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp GRAVE &kp U>;
        };

        /* Dead-key accents, uppercase */
        cETrem: cETrem {
            compatible = "zmk,behavior-macro";
            label = "cETrem";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp LS(APOSTROPHE) &kp LS(E)>;
        };

        cITrem: cITrem {
            compatible = "zmk,behavior-macro";
            label = "cITrem";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp LS(APOSTROPHE) &kp LS(I)>;
        };

        cICir: cICir {
            compatible = "zmk,behavior-macro";
            label = "cICir";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp LS(I)>;
        };

        cACir: cACir {
            compatible = "zmk,behavior-macro";
            label = "cACir";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp LS(A)>;
        };

        cOCir: cOCir {
            compatible = "zmk,behavior-macro";
            label = "cOCir";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp LS(O)>;
        };

        cECir: cECir {
            compatible = "zmk,behavior-macro";
            label = "cECir";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp LS(E)>;
        };

        cUcir: cUcir {
            compatible = "zmk,behavior-macro";
            label = "cUcir";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp CARET &kp LS(U)>;
        };

        cAGrv: cAGrv {
            compatible = "zmk,behavior-macro";
            label = "cAGrv";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp GRAVE &kp LS(A)>;
        };

        cEGrv: cEGrv {
            compatible = "zmk,behavior-macro";
            label = "cEGrv";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp GRAVE &kp LS(E)>;
        };

        cUGrv: cUGrv {
            compatible = "zmk,behavior-macro";
            label = "cUGrv";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp GRAVE &kp LS(U)>;
        };

        /* Paired delimiters: type pair, step cursor back inside */
        Double_Par: Double_Par {
            compatible = "zmk,behavior-macro";
            label = "Double_Par";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
        };

        Double_Cro: Double_Cro {
            compatible = "zmk,behavior-macro";
            label = "Double_Cro";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
        };

        Double_Acc: Double_Acc {
            compatible = "zmk,behavior-macro";
            label = "Double_Acc";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
        };

        DoubleInt: DoubleInt {
            compatible = "zmk,behavior-macro";
            label = "DOUBLEINT";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp RA(SLASH) &kp QUESTION &kp LEFT>;
        };

        DoubleExc: DoubleExc {
            compatible = "zmk,behavior-macro";
            label = "DOUBLEEXC";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp RA(N1) &kp EXCL &kp LEFT>;
        };

        /* "où " : O + dead grave + U + SPACE */
        ougrv: ougrv {
            compatible = "zmk,behavior-macro";
            label = "OUGRV";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&macro_tap>, <&kp O &kp GRAVE &kp U &kp SPACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Power {
            bindings = <&kp LA(F4)>;
            key-positions = <39 40 41>;
            layers = <1 0 3 4 2 5>;
        };

        ScreenShot {
            bindings = <&kp LG(LS(S))>;
            key-positions = <2 3 4>;
            layers = <1 0 3 2 4 5>;
        };

        ougrvc {
            bindings = <&ougrv>;
            key-positions = <7 8 9>;
        };

        ActBoot {
            bindings = <&tog 6>;
            key-positions = <13 14 15 16 17>;
        };

        combo_apo_a {
            bindings = <&apo_a>;
            key-positions = <7 22>;
            layers = <0>;
        };

        combo_apo_e {
            bindings = <&apo_e>;
            key-positions = <7 20>;
            layers = <0>;
        };

        combo_apo_i {
            bindings = <&apo_i>;
            key-positions = <7 21>;
            layers = <0>;
        };

        combo_apo_o {
            bindings = <&apo_o>;
            key-positions = <7 8>;
            layers = <0>;
        };

        combo_apo_u {
            bindings = <&apo_u>;
            key-positions = <7 9>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Layer0_Base {
            display-name = "0_Rosellae";
            bindings = <
&kp ESCAPE      &kp B   &kp L         &kp D             &kp C       &kp V   &kp Z  &ApoGui  &kp O        &kp U          &kp X        &kp BSPC
&kp TAB         &kp N   &kp R         &kp T             &kp S       &kp F   &kp Y  &kp H    &kp E        &kp I          &kp A        &kp ENTER
&kp LEFT_WIN    &qu     &kp J         &kp M             &kp G       &kp W   &kp K  &kp P    &Virg_Inter  &Point_Excl    &Colon_Scl   &kp LC(LSHIFT)
&sk LEFT_SHIFT  &sl 1   &Ctrl_to_Nav  &Nav_to_FLaunch   &kp SPACE   &Altgralt
            >;
        };

        Layer1_Accents {
            display-name = "1_Rosellae";
            bindings = <
&trans            &kp LC(Z)  &kp LC(Y)  &kp RA(P)  &kp RA(Y)  &none       &uUGrv    &iICir    &eECir        &uUcir    &kp RA(O)  &trans
&kp LA(TAB)       &kp RA(Z)  &kp RA(N)  &oeOE      &eETrem    &kp RA(Q)   &kp RA(U) &kp RA(COMMA) &aAGrv    &eEGrv    &kp RA(E)  &trans
&kp LS(LC(TAB))   &kp Q      &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(A)   &iITrem   &aACir    &kp RA(I)     &oOCir    &kp RA(A)  &trans
&trans            &trans     &trans     &trans     &trans     &trans
            >;
        };

        Layer2_Symbol {
            display-name = "2_Rosellae";
            bindings = <
&trans  &kp RA(N5)  &kp DOLLAR  &Double_Cro  &kp CARET     &kp TILDE  &none   &kp LESS_THAN  &kp GREATER_THAN  &kp AMPERSAND  &kp NON_US_BACKSLASH  &kp DELETE
&trans  &kp PLUS    &kp EQUAL   &Double_Par  &kp ASTERISK  &FlecheDr  &kp HASH &kp UNDERSCORE &kp MINUS        &kp AT_SIGN    &kp SLASH             &trans
&trans  &Mqu        &Fois       &Double_Acc  &kp GRAVE     &none      &none   &kp PERCENT    &DoubleInt        &DoubleExc     &kp PIPE              &trans
&trans  &trans      &trans      &trans       &trans        &trans
            >;
        };

        Layer3_Nav {
            display-name = "3_Rosellae";
            bindings = <
&trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp END    &kp PAGE_DOWN  &kp PG_UP  &kp HOME   &kp F2   &kp F4   &kp F11     &trans
&trans  &kp LEFT    &kp DOWN          &kp UP      &kp RIGHT  &kp MINUS      &kp SLASH  &kp COMMA  &kp N4   &kp N5   &kp N6      &trans
&trans  &kp N1      &kp N2            &kp N3      &kp N0     &kp PLUS       &kp EQUAL  &kp N7     &kp N8   &kp N9   &kp PERIOD  &trans
&trans  &trans      &trans            &trans      &trans     &trans
            >;
        };

        Layer4_Gaming {
            display-name = "4_Rosellae";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp R   &kp UP  &kp SPACE  &kp SPACE  &kp UP  &kp R
            >;
        };

        Layer5_Arabic {
            display-name = "5_Rosellae";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Bootloader {
            display-name = "Bootloader";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_CLR_ALL  &bt BT_NXT  &trans  &trans  &trans
            >;
        };
    };
};
